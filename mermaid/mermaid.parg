  flowchart_hash_run_cg = 1*( 1*( !( "\t" / "\n" / "\r" / " " / "#" / "," / ";" ) ANY ) / !flowchart_comma_gap !"#" !";" !newline !sp ANY ) / flowchart_hash_terminated_space

