  flowchart_run = 1*( 1*( !( "\t" / "\n" / "\r" / " " / ";" ) ANY ) / !";" !newline !sp ANY ) / flowchart_declaration_space

  flowchart_run_hcg = 1*( 1*( !( "\t" / "\n" / "\r" / " " / "," / ";" ) ANY ) / !flowchart_hashed_comma_gap !";" !newline !sp ANY ) / flowchart_declaration_space

  flowchart_run_st = 1*( 1*( !( "\t" / "\n" / "\r" / " " / "(" / ")" / "-" / ":" / ";" / "<" / "=" / ">" / "@" / "[" / "]" / "^" / "{" / "|" / "}" / "~" ) ANY ) / !flowchart_structural_token !";" !newline !sp ANY ) / flowchart_declaration_space

  ## hash_terminated_run(*guards)
