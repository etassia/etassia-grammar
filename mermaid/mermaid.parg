  flowchart_link_tail = [ sp flowchart_quoted_run ] [ sp flowchart_link_target ]

  flowchart_href_action = "href" sp flowchart_quoted_run flowchart_link_tail

  flowchart_link_action = flowchart_quoted_run flowchart_link_tail

  flowchart_token_char = n_09_0A_0D_20_28_29_2D_3A_3B_3C_3D_3E_40_5B_5D_5E_7B_7C_7D_7E / ( !sp !flowchart_line_end !";" !flowchart_structural_token ANY )

  flowchart_bare_token = !flowchart_reserved_keyword !"\"" 1*( 1*( !( "\t" / "\n" / "\r" / " " / "(" / ")" / "-" / ":" / ";" / "<" / "=" / ">" / "@" / "[" / "]" / "^" / "{" / "|" / "}" / "~" ) ANY ) / flowchart_token_char )

