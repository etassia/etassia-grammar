  class_note = "note" as ignored [ sp "for" sp class_name as note_for ] sp class_rest as note_text line_end

  class_standalone = class_ref line_end

  class_cardinality = class_string

    class_operator = ( "|>..|>" / "|>..<|" / "|>--|>" / "|>--<|" / "<|..|>" / "<|..<|" / "<|--<|" / "<|--|>" / "*--<|" / "*--|>" / "*..<|" / "*..|>" / "o--<|" / "o--|>" / "o..<|" / "o..|>" / ">..|>" / ">..<|" / "<--<|" / "<--|>" / "<..<|" / "<..|>" / ">--|>" / ">--<|" / "<|--*" / "<|--o" / "<|--<" / "<|-->" / "<|..*" / "<|..o" / "<|..<" / "<|..>" / "|>--*" / "|>--o" / "|>--<" / "|>-->" / "|>..>" / "|>..<" / "|>..o" / "|>..*" / "*--<" / "<..*" / "<..o" / "<..<" / "<..>" / "*--o" / "*--*" / ">--*" / ">--o" / ">--<" / ">-->" / ">..*" / ">..o" / ">..<" / ">..>" / "*..>" / "*..<" / "o--*" / "o--o" / "o--<" / "o-->" / "*..o" / "*..*" / "o..*" / "o..o" / "o..<" / "o..>" / "<--*" / "<--o" / "<--<" / "<-->" / "*-->" / "o.." / "<|--" / "--|>" / "*--" / "--*" / "o--" / "--o" / "..|>" / "<|.." / "..>" / "<.." / "-->" / "<--" / "--" / ".." ) as arrow

  class_pipe_label = "|" 1*( !"|" ANY ) as label_text "|"

  class_colon_label = *sp ":" *sp 1*( 1*( !( "\t" / "\n" / "\r" / " " / "%" / ";" ) ANY ) / le_mid / !line_end ANY ) as label_text

