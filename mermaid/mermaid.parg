  ## The look-ahead keeps an ASCII character from walking the whole letter table.
  class_name_char = ALPHA / DIGIT / "_" / &%x80-10FFFF class_unicode_letter

  class_rest = 1*( 1*( !( "\t" / "\n" / "\r" / " " / "%" / ";" ) ANY ) / le_mid / !line_end ANY )

  class_direction_value = ( "TD" / "TB" / "LR" / "RL" / "BT" ) as dir_value

  class_header = "classDiagram-v2" as header *sp &( newline / eof ) ws / "classDiagram" as header !( class_name_char / "-" ) *sp [ class_direction_value as direction ] *sp &( newline / eof ) ws

  class_backtick_name = "`" 1*( !"`" ANY ) "`"

